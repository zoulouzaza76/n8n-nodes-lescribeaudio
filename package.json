{
  "name": "n8n-nodes-lescribeaudio",
  "version": "1.0.2",
  "description": "Official n8n community node for Le Scribe Audio Public REST API & HMAC-SHA256 Webhooks (French 2-pass AI audio/video transcription to Word .docx, SRT, VTT, JSON & executive/chrono-thematic summary).",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "transcription",
    "audio-to-text",
    "speech-to-text",
    "french",
    "rgpd",
    "rgaa",
    "lescribeaudio"
  ],
  "license": "MIT",
  "homepage": "https://lescribeaudio.com/integrations-mcp",
  "author": {
    "name": "Le Scribe Audio",
    "email": "info@lescribeaudio.com",
    "url": "https://lescribeaudio.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoulouzaza76/n8n-nodes-lescribeaudio.git"
  },
  "bugs": {
    "url": "https://github.com/zoulouzaza76/n8n-nodes-lescribeaudio/issues"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp nodes/LeScribeAudio/*.svg dist/nodes/LeScribeAudio/",
    "test": "node --test test/node.test.mjs"
  },
  "files": [
    "dist",
    "workflows",
    "README.md",
    "LICENSE"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/LeScribeAudioApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/LeScribeAudio/LeScribeAudio.node.js",
      "dist/nodes/LeScribeAudio/LeScribeAudioTrigger.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "n8n-workflow": "*",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
